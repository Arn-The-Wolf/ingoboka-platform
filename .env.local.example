# Local development — copy to .env.local (never commit .env.local)

# Ingoboka API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8085/api/v1

# Production (Vercel) — same-origin proxy avoids mixed-content + CORS
# NEXT_PUBLIC_API_BASE_URL=/api/v1
# API_PROXY_TARGET=https://your-api-host.example.com

# Demo login panel (development / NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true only)
# Match seeded users from ingoboka-api deploy/.env — do not commit real passwords.
# NEXT_PUBLIC_DEMO_PASSWORD=
# NEXT_PUBLIC_DEMO_ADMIN_EMAIL=platform-admin@example.com
# NEXT_PUBLIC_DEMO_INSURER_EMAIL=partner-admin@example.com
# NEXT_PUBLIC_DEMO_CITIZEN_ID=0780000001

# Server-only: marketing catalog proxy (never expose password to browser)
# CATALOG_SERVICE_EMAIL=your-catalog-service@example.com
# CATALOG_SERVICE_PASSWORD=

# Optional
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_ENABLE_PWA=false
