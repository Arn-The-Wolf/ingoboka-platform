# Database
DB_URL=jdbc:postgresql://localhost:5432/ingoboka
DB_USER=ingoboka
DB_PASSWORD=ingoboka_dev_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail (Mailhog)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT
JWT_SECRET=change-me-to-a-secure-random-string-at-least-256-bits-long
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ingoboka_minio
S3_SECRET_KEY=ingoboka_minio_secret
S3_DOCUMENTS_BUCKET=ingoboka-documents
S3_PUBLIC_BUCKET=ingoboka-public
S3_PRESIGNED_URL_EXPIRY_SECONDS=3600

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# Payment
PAYMENT_PROVIDER=sandbox
MOMO_COLLECTION_URL=
MOMO_SUBSCRIPTION_KEY=
MOMO_CALLBACK_BASE_URL=

# SMS
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=Ingoboka

# Payment sandbox
PAYMENT_SANDBOX_HMAC_SECRET=change-me-sandbox-hmac-secret

# Spring profile (use 'dev' for seed data)
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8080
